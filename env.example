# Copia questo file in ".env" (non ".env.example") e inserisci i tuoi valori reali.
# Il file ".env" NON va mai caricato su GitHub o condiviso — contiene le chiavi segrete.

# Supabase → pulsante "Connect" in alto → scheda "Direct" → Connection string.
# Sostituisci [YOUR-PASSWORD] con la password vera del database (senza parentesi quadre).
DATABASE_URL=postgresql://postgres.xxxxx:LaTuaPassword@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# Dashboard Stripe → Sviluppatori → Chiavi API (usa quelle che iniziano con "sk_test_" finché sei in test)
STRIPE_SECRET_KEY=sk_test_...

# La ottieni con `stripe listen --forward-to localhost:3000/api/webhook` (vedi README)
STRIPE_WEBHOOK_SECRET=whsec_...

# L'indirizzo dove serví il sito (il file hotel-aquila.html). In locale, se lo apri con
# un server statico su porta 5500, lascialo così. In produzione, l'URL reale del sito.
FRONTEND_URL=http://localhost:5500

PORT=3000
